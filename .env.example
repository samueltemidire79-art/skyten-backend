# =========================================
# SKYTEN BACKEND - ENVIRONMENT VARIABLES
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to Git.
# =========================================

# --- DATABASE (Supabase Postgres connection string) ---
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Use the "Connection Pooling" (port 6543) string for serverless/Render deployments,
# and the direct (port 5432) string for local Prisma migrations if pooling gives you trouble.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- AUTH ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_this_with_a_long_random_string"
JWT_EXPIRES_IN="7d"

# --- SERVER ---
PORT=5000
NODE_ENV="development"

# --- CORS ---
# The URL of your frontend app (update when your frontend dev gives you their deployed URL)
CLIENT_URL="http://localhost:3000"
